@model IEnumerable<CustomerAdminPortal.Models.Entities.Customer>

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-0">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Dashboard</h2>
            <p class="text-secondary mb-0">
                Welcome to Customer Admin Portal.
            </p>
        </div>

        <a asp-controller="Customers"
           asp-action="Create"
           class="btn btn-primary">
            + Add Customer
        </a>
    </div>

    <div class="row g-4 mb-4">

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="text-secondary mb-2">
                        Total Customers
                    </div>
                    <h2 class="fw-bold mb-0">
                        @ViewBag.TotalCustomers
                    </h2>
                    <div class="small text-success mt-2">
                        Registered customer records
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="text-secondary mb-2">
                        Total Salary
                    </div>
                    <h2 class="fw-bold mb-0">
                        ₹@(((decimal)ViewBag.TotalSalary).ToString("N2"))
                    </h2>
                    <div class="small text-secondary mt-2">
                        Combined salary of all customers
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-1">Recent Customers</h5>
                    <p class="text-secondary small mb-0">
                        Latest five customer records
                    </p>
                </div>

                <a asp-controller="Customers"
                   asp-action="Index"
                   class="btn btn-outline-primary btn-sm">
                    View All
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Customer ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Salary</th>
                        <th class="text-end pe-4">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td class="ps-4">@customer.Id</td>
                                <td class="fw-semibold">@customer.Name</td>
                                <td>@customer.Email</td>
                                <td>₹@customer.Salary.ToString("N2")</td>
                                <td class="text-end pe-4">
                                    <a asp-controller="Customers"
                                       asp-action="Edit"
                                       asp-route-id="@customer.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-secondary">
                                No customer records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
