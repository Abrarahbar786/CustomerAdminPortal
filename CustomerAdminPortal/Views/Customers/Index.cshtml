@model IEnumerable<CustomerAdminPortal.Models.Entities.Customer>

@{
    ViewData["Title"] = "Customer List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Customer List</h2>
            <p class="text-secondary">Manage your customers.</p>
        </div>

        <a asp-controller="Customers"
           asp-action="Create"
           class="btn btn-primary">
            + Add Customer
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <form asp-controller="Customers" asp-action="Index" method="get"
          class="mb-3">
        <div class="input-group">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search by name or email..." />
            <button type="submit" class="btn btn-outline-primary">
                Search
            </button>
        </div>
    </form>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Sr. No.</th>
                        <th>Customer ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Salary</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int serialNumber = (((int)ViewBag.CurrentPage - 1) * 5) + 1;
                    }
                    @foreach (var customer in Model)
                    {
                      <tr>
                         <td>@(serialNumber++)</td>
                         <td>@customer.Id</td>
                         <td>@customer.Name</td>
                         <td>@customer.Email</td>
                         <td>@customer.Phone</td>
                         <td>₹@customer.Salary.ToString("N2")</td>
                         <td>
                           <a asp-action="Edit"
                             asp-route-id="@customer.Id"
                              class="btn btn-sm btn-outline-primary">
                               Edit
                           </a>
                              <a asp-action="Delete"
                                   asp-route-id="@customer.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4">
                                No customers found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3 d-flex justify-content-between align-items-center">
        <span class="text-secondary">
            Total matching customers: @ViewBag.TotalCustomers
        </span>

        <div class="d-flex gap-2">
            @if ((int)ViewBag.CurrentPage > 1)
            {
                <a class="btn btn-outline-secondary"
                   asp-action="Index"
                   asp-route-search="@ViewBag.Search"
                   asp-route-page="@((int)ViewBag.CurrentPage - 1)">
                    Previous
                </a>
            }

            @if ((int)ViewBag.CurrentPage < (int)ViewBag.TotalPages)
            {
                <a class="btn btn-outline-secondary"
                   asp-action="Index"
                   asp-route-search="@ViewBag.Search"
                   asp-route-page="@((int)ViewBag.CurrentPage + 1)">
                    Next
                </a>
            }
        </div>
    </div>
</div>
