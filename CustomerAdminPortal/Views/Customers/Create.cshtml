@model CustomerAdminPortal.Models.Entities.Customer
@{
	ViewData["Title"] = "Add Customer";
	Layout = "~/Views/Shared/_Layout.cshtml";

}

<div class="container-fluid px-0">
	<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
		<div>

			<h2 class="fw-bold mb-1">Add Customer</h2>
			<p class="text-secondary mb-0">
				Enter the customer details below.
			</p>
		</div>
		
		<a asp-controller="Customers"
		asp-action="Index"
		class="btn btn-outline-secondary">
		<i class="bu bi-arrow-left"></i>Back to Customers
	</a>
	</div>

	<div class="card border-0 shadow-sm rounded-4">
		<div class="card-header bg-white border-0 px-4 pt-4">
			<h5 class="fw-semibold mb-1">Customer Information</h5>
			<p class="text-secondary small mb-0">
				Fields marked * are required.
			</p>
		</div>

		<div class="card-body p4">
			<form asp-controller="Customers"
			asp-action="Create"
			method="post">

			<div asp-validation-summary="ModelOnly"
			class="alert alert-danger"
			role="alert"></div>

			<div class="row g-4">
				<div class="col-md-6">
					<label asp-for="Name" class="form-label fw-semibold">
						Full Name *
					</label>
					<input asp-for="Name"
					class="form-control form-control-lg"
							   placeholder="Enter full name" />
							   <span asp-validation-for="Name" />
							   <span asp-validation-for="Name"
							   class="text-danger small"></span>					    
				</div>

				<div class="col-md-6">
					<label asp-for="Email" class="form-label fw-semibold">
							Email Address *
					</label>
					<input asp-for="Email"
					type="email"
					class="form-control form-control-lg"
					placeholder="name@example.com" />
					<span asp-validation-for="Email"
					class="text-danger small"></span>
				</div>

				<div class="md-6">
					<label asp-for="Phone" class="form-label fw-semibold">
						Phone Number
					</label>  
					<input asp-for="Phone"
					type="tel"
					class="form-control form-control-lg"
					placeholder="Enter phone number" />
					<span asp-validation-for="Phone"
					class="text-danger small"></span>
					</div>
                    <div class="col-md-6">
						<label asp-for="Salary" class="form-label fw-semibold">
							Salary (₹) *
						</label>
						<input asp-for="Salary"
						type="number"
						min="0"
						step="0.01"
						class="form-control form-control-lg"
						placeholder="Enter salary" />
						<span asp-validation-for="Salary"
						class="text-danger small"></span>
					</div>
			</div>
			
			<hr class="my-4" />

			<div class="d-flex justify-content-end gap-2 flex-wrap">
				<a asp-conttroller="Customers"
                 asp-action="Index"
                 class="btn btn-light border px-4">
				  Cancel
                </a>

				<button type="submit" class="btn btn-primary px-4">
					<i class="bi bi-person-plus"></i> Save Customer
				</button>
			</div>
		  </form>
		</div>
	</div>
</div>
