@model CustomerAdminPortal.Models.Entities.Customer

@{
    ViewData["Title"] = "Edit Customer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-0">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Edit Customer</h2>
            <p class="text-secondary mb-0">
                Update the customer information below.
            </p>
        </div>

        <a asp-controller="Customers"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Customer List
        </a>
    </div>

    <!-- Edit Form Card -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white border-0 px-4 pt-4">
            <h5 class="fw-semibold mb-1">Customer Information</h5>
            <p class="text-secondary small mb-0">
                Customer ID: @Model.Id
            </p>
        </div>

        <div class="card-body p-4">

            <form asp-controller="Customers"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>

                <div class="row g-4">

                    <!-- Name -->
                    <div class="col-md-6">
                        <label asp-for="Name"
                               class="form-label fw-semibold">
                            Full Name
                        </label>

                        <input asp-for="Name"
                               class="form-control form-control-lg"
                               placeholder="Enter customer name" />

                        <span asp-validation-for="Name"
                              class="text-danger small"></span>
                    </div>

                    <!-- Email -->
                    <div class="col-md-6">
                        <label asp-for="Email"
                               class="form-label fw-semibold">
                            Email Address
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control form-control-lg"
                               placeholder="name@example.com" />

                        <span asp-validation-for="Email"
                              class="text-danger small"></span>
                    </div>

                    <!-- Phone -->
                    <div class="col-md-6">
                        <label asp-for="Phone"
                               class="form-label fw-semibold">
                            Phone Number
                        </label>

                        <input asp-for="Phone"
                               type="tel"
                               class="form-control form-control-lg"
                               placeholder="Enter phone number" />

                        <span asp-validation-for="Phone"
                              class="text-danger small"></span>
                    </div>

                    <!-- Salary -->
                    <div class="col-md-6">
                        <label asp-for="Salary"
                               class="form-label fw-semibold">
                            Salary (₹)
                        </label>

                        <input asp-for="Salary"
                               type="number"
                               min="0"
                               step="0.01"
                               class="form-control form-control-lg"
                               placeholder="Enter salary" />

                        <span asp-validation-for="Salary"
                              class="text-danger small"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-2 flex-wrap">

                    <a asp-controller="Customers"
                       asp-action="Index"
                       class="btn btn-light border px-4">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        Save Changes
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>
